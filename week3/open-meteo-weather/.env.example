# Wallet that receives payments. Use the receive address shown by
# `kpass wallet address` or any EOA you control on the Kite chain.
PAY_TO=0xYourKiteWalletAddress

# mainnet (USDC.e on eip155:2366) or testnet (pieUSD on eip155:2368)
KITE_NETWORK=testnet

# The API you are wrapping. /v1/<path> on this service proxies to
# join(UPSTREAM_URL path, /<path>); include any endpoint prefix in this URL
# (e.g. .../v1 so /v1/forecast reaches the upstream's /v1/forecast).
UPSTREAM_URL=https://api.open-meteo.com/v1
# Optional credential injected into every upstream request.
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=

# Price per call in USD, charged in the network's stablecoin.
PRICE_USD=0.001
SERVICE_DESCRIPTION=Open-Meteo weather forecast (hourly/daily) for any coordinate

PORT=8080
# FACILITATOR_URL=https://facilitator.pieverse.io/v2
